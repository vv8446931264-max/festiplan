# Copy to .env.local for local development. Never commit real values: .env* is git-ignored
# and nothing here is ever exposed to the browser (no NEXT_PUBLIC_ variables exist).

# Local / cloud-dev: an AI Studio key (server-only). Leave empty to run in template mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Production (Cloud Run) uses Vertex AI via Application Default Credentials — no key.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Set GOOGLE_CLOUD_PROJECT to use Firestore; unset = in-memory store.
# Named Native-mode database (the project's default DB is Datastore-mode and is not used).
# FIRESTORE_DATABASE=festiplan

# Canonical origin for metadata, sitemap and share links (no trailing slash).
# SITE_URL=http://localhost:3000

# Proxies that append to X-Forwarded-For in front of the app (Cloud Run = 1, the default).
# TRUSTED_PROXY_HOPS=1

# Multiplies every per-client rate limit (positive integer; e2e tests raise it).
# RATE_LIMIT_SCALE=1
