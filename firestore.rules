rules_version = '2';

// FestiPlan never lets a browser talk to Firestore. Plans are read and written only by
// the Next.js server on Cloud Run through the server SDK with Application Default
// Credentials, which bypasses these rules. Access control for edits lives in the API
// (edit-key hash check). So every direct client read and write is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
